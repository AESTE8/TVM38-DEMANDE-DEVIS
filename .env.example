# Resend (service d'envoi d'emails)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=your-verified-email@domain.com

# Email destinataire des demandes de devis
TVM38_STAFF_EMAIL=staff@votredomaine.fr

# Supabase
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Les messages du site (récupération d'identifiants, ouverture de compte, avis)
# passent par l'edge function `contact-site`. Web3Forms a été retiré : plus
# aucune clé publique ni donnée personnelle ne transite par un tiers.

# ---------------------------------------------------------------------------
# Secrets des edge functions — espace client
# ---------------------------------------------------------------------------
# Ceux-ci ne vont PAS dans le .env du frontend : ils se posent avec
# `supabase secrets set ...`. Ils sont listés ici uniquement pour mémoire.
# Voir docs/ESPACE-CLIENT.md.

# Signature des jetons client (32 caractères minimum) — `openssl rand -base64 48`
# CLIENT_JWT_SECRET=...

# Compte de service Google, fichier JSON entier sur une seule ligne.
# Ne doit exister que dans les secrets Supabase, jamais dans le logiciel desktop.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Dossier des PDF dans le Drive partagé (Shared Drive obligatoire)
# GOOGLE_DRIVE_FOLDER_ID=1AbC...
